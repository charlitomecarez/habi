{
  "expo": {
    "name": "Habi",
    "slug": "my-app",
    "version": "1.6.0",
    "scheme": "myapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.charli.myapp",
      "adaptiveIcon": {
        "backgroundColor": "#23205C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#23205C",
          "dark": { "image": "./assets/splash-icon.png", "backgroundColor": "#23205C" }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Habi uses your photos to add pictures of your inventory items.",
          "cameraPermission": "Habi uses the camera to take pictures of your inventory items.",
          "microphonePermission": "Habi uses the microphone to record voice messages for your partner."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Habi uses the microphone to record voice messages for your partner.",
          "enableBackgroundPlayback": false
        }
      ],
      "react-native-libsodium",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Habi uses the camera to scan the QR labels on your storage boxes and your alarm stop label.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Habi uses your location only when you tap Use my location, to show your weather and places near you."
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Sleep",
              "label": "Sleep",
              "description": "Last night's sleep",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "previewImage": "./assets/icon.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ScreenTime",
              "label": "Screen time",
              "description": "Today's screen time, with no app names",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "previewImage": "./assets/icon.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "fcfabf83-7cbd-4317-ba50-42daf9d6f6a7"
      }
    },
    "owner": "javaplum"
  }
}
